# Copy to .env and edit. Every value below is optional; defaults work locally.

# ── Database ──────────────────────────────────────────────────────────────
# SQLite by default. Point at Postgres for production.
# DATABASE_URL=postgresql+psycopg2://handoff:handoff@localhost:5432/handoff

# ── Embeddings ────────────────────────────────────────────────────────────
# tfidf_svd            deterministic, no download, fits on your corpus
# sentence_transformers better semantics, needs torch (~2 GB)
EMBEDDER_BACKEND=tfidf_svd
EMBEDDING_DIM=128

# ── Retrieval ─────────────────────────────────────────────────────────────
TOP_K=3
RELEVANCE_THRESHOLD=0.55
MIN_QUERY_TFIDF_MASS=0.35
MIN_QUERY_COVERAGE=0.30

# ── Freshness scoring ─────────────────────────────────────────────────────
STALENESS_THRESHOLD_DAYS=30
FRESHNESS_MODE=penalty
FRESHNESS_DECAY=0.35
FRESHNESS_WEIGHT_FLOOR=0.45
DRIFT_PENALTY=0.40

# ── Integration thresholds ────────────────────────────────────────────────
LATENCY_THRESHOLD_MS=500
ERROR_RATE_THRESHOLD=2.0
THROUGHPUT_CV_THRESHOLD=0.20

# ── Scheduler ─────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false
HEALTH_CHECK_INTERVAL_MINUTES=60

# ── Snowflake (optional) ──────────────────────────────────────────────────
# Unset means health reports fall back to data/artifacts/snowflake_fallback.jsonl
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=handoff_svc
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=ENTERPRISE_AI_OPS
# SNOWFLAKE_SCHEMA=HANDOFF_KIT

# ── AWS S3 (optional) ─────────────────────────────────────────────────────
# Unset means reports fall back to data/artifacts/
# AWS_REGION=us-east-1
# S3_BUCKET=enterprise-ai-handoff-kit
# S3_PREFIX=health-reports/

# ── Services ──────────────────────────────────────────────────────────────
PYTHON_API_URL=http://localhost:8000
API_PORT=8000

# ── Claude ────────────────────────────────────────────────────────────────
# The API key is NEVER read from here. It is pasted into the dashboard
# per session and held only in memory.
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1500
